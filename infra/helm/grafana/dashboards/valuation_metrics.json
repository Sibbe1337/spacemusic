{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "prometheus", "id": "prometheus", "name": "Prometheus", "version": "2.0.0"}
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "title": "Valuation run rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "sum(rate(valuation_runs_total[5m])) by (status)", "legendFormat": "{{status}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "Valuation run duration p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(valuation_run_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A"}],
      "unit": "s",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "Valuation errors",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "sum(rate(valuation_app_errors_total[5m])) by (component, error_type)", "legendFormat": "{{component}} / {{error_type}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "title": "Worker event publishing",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "sum(increase(valuation_runs_total{status=\"success\"}[1h]))", "legendFormat": "Successful valuations", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "reduceOptions": {"calcs": ["lastNotNull"]}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 37,
  "tags": ["valuation-service", "underwriting"],
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "Prometheus"}}]},
  "time": {"from": "now-1h", "to": "now"},
  "title": "Royalty Valuation Worker Metrics",
  "uid": "valuation-service-dashboard",
  "version": 3
}
