justify-between bg-white rounded-xl p-4 hover:bg-cream-dark transition-colors group" href="/glossary/pro/"><span class="text-sm font-medium">PRO Registration</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 text-white/60 group-hover:text-ink-faint group-hover:translate-x-0.5 transition-all"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="flex items-center justify-between bg-white rounded-xl p-4 hover:bg-cream-dark transition-colors group" href="/glossary/streaming-royalties/"><span class="text-sm font-medium">Streaming Royalties</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 text-white/60 group-hover:text-ink-faint group-hover:translate-x-0.5 transition-all"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="flex items-center justify-between bg-white rounded-xl p-4 hover:bg-cream-dark transition-colors group" href="/guides/how-to-sell-music-rights/"><span class="text-sm font-medium">How to Sell Your Music Rights</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4 text-white/60 group-hover:text-ink-faint group-hover:translate-x-0.5 transition-all"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></section><section class="bg-white py-16"><div class="max-w-3xl mx-auto px-4"><p class="text-xs font-medium text-ink-muted uppercase tracking-widest mb-6">FAQ</p><div class="w-full" data-orientation="vertical"><div data-state="closed" data-orientation="vertical" clas