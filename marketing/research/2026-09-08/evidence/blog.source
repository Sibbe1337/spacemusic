-toast][data-type=success] [data-close-button]{background:var(--success-bg);border-color:var(--success-border);color:var(--success-text)}[data-rich-colors=true][data-sonner-toast][data-type=info],[data-rich-colors=true][data-sonner-toast][data-type=info] [data-close-button]{background:var(--info-bg);border-color:var(--info-border);color:var(--info-text)}[data-rich-colors=true][data-sonner-toast][data-type=warning],[data-rich-colors=true][data-sonner-toast][data-type=warning] [data-close-button]{background:var(--warning-bg);border-color:var(--warning-border);color:var(--warning-text)}[data-rich-colors=true][data-sonner-toast][data-type=error],[data-rich-colors=true][data-sonner-toast][data-type=error] [data-close-button]{background:var(--error-bg);border-color:var(--error-border);color:var(--error-text)}.sonner-loading-wrapper{--size: 16px;height:var(--size);width:var(--size);position:absolute;inset:0;z-index:10}.sonner-loading-wrapper[data-visible=false]{transform-origin:center;animation:sonner-fade-out .2s ease forwards}.sonner-spinner{position:relative;top:50%;left:50%;height:var(--size);width:var(--size)}.sonner-loading-bar{animation:sonner-spin 1.2s linear infinite;background:var(--gray11);border-radius:6px;height:8%;left:-10%;position:absolute;top:-3.9%;width:24%}.sonner-loading-bar:nth-child(1){animation-delay:-1.2s;transform:rotate(.0001deg) translate(146%)}.sonner-loading-bar:nth-child(2){animation-delay:-1.1s;transform:rotate(30deg) translate(146%)}.sonner-loading-bar:nth-child(3){animation-delay:-1s;transform:rotate(60deg) translate(146%)}.sonner-loading-bar:nth-child(4){animation-delay:-.9s;transform:rotate(90deg) translate(146%)}.sonner-loading-bar:nth-child(5){animation-delay:-.8s;transform:rotate(120deg) translate(146%)}.sonner-loading-bar:nth-child(6){animation-delay:-.7s;transform:rotate(150deg) translate(146%)}.sonner-loading-bar:nth-child(7){animation-delay:-.6s;transform:rotate(180deg) translate(146%)}.sonner-loading-bar:nth-child(8){animation-delay:-.5s;transform:rotate(210deg) translate(146%)}.sonner-loading-bar:nth-child(9){animation-delay:-.4s;transform:rotate(240deg) translate(146%)}.sonner-loading-bar:nth-child(10){animation-delay:-.3s;transform:rotate(270deg) translate(146%)}.sonner-loading-bar:nth-child(11){animation-delay:-.2s;transform:rotate(300deg) translate(146%)}.sonner-loading-bar:nth-child(12){animation-delay:-.1s;transform:rotate(330deg) translate(146%)}@keyframes sonner-fade-in{0%{opacity:0;transform:scale(.8)}to{opacity:1;transform:scale(1)}}@keyframes sonner-fade-out{0%{opacity:1;transform:scale(1)}to{opacity:0;transform:scale(.8)}}@keyframes sonner-spin{0%{opacity:1}to{opacity:.15}}@media (prefers-reduced-motion){[data-sonner-toast],[data-sonner-toast]>*,.sonner-loading-bar{transition:none!important;animation:none!important}}.sonner-loader{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);transform-origin:center;transition:opacity .2s,transform .2s}.sonner-loader[data-visible=false]{opacity:0;transform:scale(.8) translate(-50%,-50%)}
</style><link rel="modulepreload" as="script" crossorigin="" href="/assets/Navbar-DK5bZPep-journey-396b323aebc9.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/accordion-DNmmZSWQ.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/Footer-CiCbq8u0-journey-396b323aebc9.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/CookieBanner-BhC_lodR.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/SEOHead-C4J8_WVH.js"><meta name="description" content="SPACE buys revenue-generating music catalogs directly. Request a free individual review or explore a hypothetical sale scenario. No obligation to sell." data-rh="true"><meta property="og:description" content="SPACE buys revenue-generating music catalogs directly. Request a free individual review or explore a hypothetical sale scenario. No obligation to sell." data-rh="true"><meta name="twitter:description" content="SPACE buys revenue-generating music catalogs directly. Request a free individual review or explore a hypothetical sale scenario. No obligation to sell." data-rh="true"><script type="application/ld+json" data-rh="true">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What kind of music catalogs does SPACE buy?","acceptedAnswer":{"@type":"Answer","text":"We review revenue-generating catalogs across genres. Ambient, meditation, lo-fi, focus, wellness, nature soundscapes, electronic, house, techno, trance and drum & bass are examples. Another genre is not a reason to rule yourself out; documented income and transferable rights need individual review."}},{"@type":"Question","name":"How does the process work?","acceptedAnswer":{"@type":"Answer","text":"Start with your contact details and artist or label name. We request supporting information privately by email, review income and rights, and may make an offer if the catalog is a fit. Payment requires a completed agreement and satisfied transfer conditions."}},{"@type":"Question","name":"Can I sell only part of my catalog?","acceptedAnswer":{"@type":"Answer","text":"You can propose selected tracks or a share of defined rights, such as 50%, 75% or 100%, subject to ownership and agreement. Recording and publishing rights are separate. Confirm exactly what transfers and what you retain."}},{"@type":"Question","name":"What do I need to qualify?","acceptedAnswer":{"@type":"Answer","text":"We review whether we can contact you, which rights you can transfer and what income your statements document. There is no automatic qualification decision from a calculator result or a stated minimum on this page. Missing information may require follow-up; an application does not guarantee an offer."}},{"@type":"Question","name":"Do I lose creative control?","acceptedAnswer":{"@type":"Answer","text":"Control depends on the agreement's scope, approvals and continuing obligations. Identify the existing recordings and works being sold, and confirm any provisions affecting future releases with an independent music lawyer."}},{"@type":"Question","name":"How is my catalog valued?","acceptedAnswer":{"@type":"Answer","text":"We review documented net income, trends, platform and track concentration, rights and contracts. The reviewer confirms the history needed. No fixed genre multiple or guaranteed price is supplied by the calculator; it only models assumptions you choose."}},{"@type":"Question","name":"How long does the process take?","acceptedAnswer":{"@type":"Answer","text":"If the catalog is a fit, an initial offer typically follows within 5-7 business days after the relevant information is received. Missing evidence or complex rights can require more time. Payment follows the completed agreement and satisfied transfer conditions."}},{"@type":"Question","name":"What payment methods do you support?","acceptedAnswer":{"@type":"Answer","text":"The existing offer policy provides for bank transfer after the agreement is complete and rights-transfer conditions are satisfied. Confirm payment instructions, currency and any deductions in the agreement."}}]}</script></head>

  <body>
    <div id="root"><div role="region" aria-label="Notifications (F8)" tabindex="-1" style="pointer-events: none;"><ol tabindex="-1" class="fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]"></ol></div><div class="min-h-screen flex flex-col w-full overflow-x-hidden"><nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-cream/80 backdrop-blur-md"><div class="max-w-5xl mx-auto px-6 sm:px-8"><div class="flex items-center justify-between h-[4.5rem]"><a class="flex items-center gap-2.5 group" aria-label="SPACE — home" href="/"><span class="text-ink transition-opacity duration-200 group-hover:opacity-60"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="flex-shrink-0"><rect x="0" y="0" width="5" height="5" rx="1" fill="currentColor" opacity="0.9"></rect><rect x="7" y="0" width="5" height="5" rx="1" fill="currentColor" opacity="0.5"></rect><rect x="13" y="0" width="5" height="5" rx="1" fill="currentColor" opacity="0.25"></rect><rect x="0" y="7" width="5" height="5" rx="1" fill="currentColor" opacity="0.5"></rect><rect x="7" y="7" width="5" height="5" rx="1" fill="currentColor" opacity="0.9"></rect><rect x="13" y="7" width="5" height="5" rx="1" fill="currentColor" opacity="0.5"></rect><rect x="0" y="13" width="5" height="5" rx="1" fill="currentColor" opacity="0.25"></rect><rect x="7" y="13" width="5" height="5" rx="1" fill="currentColor" opacity="0.5"></rect><rect x="13" y="13" width="5" height="5" rx="1" fill="currentColor" opacity="0.9"></rect></svg></span><span class="text-ink font-display font-semibold tracking-[-0.03em] text-[1.0625rem] transition-opacity duration-200 group-hover:opacity-60">SPACE</span></a><div class="hidden md:flex items-center gap-8"><a class="type-ui transition-colors duration-200 font-normal text-ink-muted hover:text-ink" href="/how-it-works/">How It Works</a><a class="type-ui transition-colors duration-200 font-normal text-ink-muted hover:text-ink" href="/sell/">Sell</a><a class="type-ui transition-colors duration-200 font-normal text-ink-muted hover:text-ink" href="/calculator/">Calculator</a><a href="/apply/" class="type-ui px-5 py-2 rounded-full bg-brand text-white hover:bg-brand-hover transition-colors duration-200">Request a free catalog review</a></div><button class="md:hidden p-2 -mr-1 text-ink-muted hover:text-ink transition-colors" aria-expanded="false" aria-controls="space-mobile-menu" aria-label="Open menu"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu h-[18px] w-[18px]"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg></button></div></div><div id="space-mobile-menu" aria-hidden="true" inert="" class="md:hidden overflow-hidden transition-all duration-300 ease-out max-h-0 opacity-0"><div class="border-t border-black/[0.08] bg-cream/98 backdrop-blur-2xl px-6 py-5"><div class="flex flex-col gap-0.5"><a class="type-ui py-3.5 transition-colors font-normal text-ink-muted hover:text-ink" href="/how-it-works/">How It Works</a><a class="type-ui py-3.5 transition-colors font-normal text-ink-muted hover:text-ink" href="/sell/">Sell</a><a class="type-ui py-3.5 transition-colors font-normal text-ink-muted hover:text-ink" href="/calculator/">Calculator</a><div class="pt-4 mt-3 border-t border-black/[0.08] space-y-2"><a href="/apply/" class="type-ui block text-center px-5 py-2.5 rounded-full bg-brand text-white hover:bg-brand-hover transition-colors">Request a free catalog review</a></div></div></div></div></nav><main><section class="relative bg-cream pt-32 pb-20 md:pt-44 md:pb-28 overflow-hidden"><div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background: radial-gradient(60% 50% at 50% -5%, rgba(42, 116, 255, 0.06), transparent 60%);"></div><div class="relative max-w-5xl mx-auto px-4 text-center"><p class="type-eyebrow text-ink-faint mb-9">Direct Music Rights Buyer</p><h1 class="type-display text-ink mb-8">Sell part of your catalog.<br><span class="text-ink-muted">Start with a free review.</span></h1><p class="type-lead text-ink-muted mb-12 measure-narrow mx-auto">SPACE buys revenue-generating music catalogs directly. Ambient, lo-fi, meditation, electronic and house are examples, not a required genre list. Every catalog is reviewed individually. No auction. No listing.</p><div class="flex flex-col sm:flex-row items-center justify-center gap-3"><a href="/apply/" class="type-ui inline-flex items-center gap-2 bg-brand text-white px-7 py-3.5 rounded-full hover:bg-brand-hover transition-colors">Request a free catalog review<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="type-ui inline-flex items-center gap-2 text-ink-muted px-7 py-3.5 rounded-full hover:text-ink transition-colors" href="/calculator/">Explore a scenario first ›</a></div><p class="type-caption text-ink-faint mt-8 measure-narrow mx-auto">Free initial review · No obligation to sell · Partial sales considered · Individual assessment across genres</p></div></section><section class="bg-white border-y border-black/[0.06]"><div class="max-w-5xl mx-auto px-4"><div class="grid grid-cols-2 md:grid-cols-4"><div class="py-8 px-6 text-center border-r border-black/[0.06]"><p class="type-metric text-ink mb-2">5–7</p><p class="type-caption text-ink-faint uppercase">Business days after relevant information, if a fit</p></div><div class="py-8 px-6 text-center border-r border-black/[0.06]"><p class="type-metric text-ink mb-2">0%</p><p class="type-caption text-ink-faint uppercase">Auction or listing commission</p></div><div class="py-8 px-6 text-center border-r border-black/[0.06]"><p class="type-metric text-ink mb-2">50–100%</p><p class="type-caption text-ink-faint uppercase">Defined rights, subject to agreement</p></div><div class="py-8 px-6 text-center "><p class="type-metric text-ink mb-2">Fit</p><p class="type-caption text-ink-faint uppercase">Rights and income reviewed individually</p></div></div></div></section><section class="py-20 md:py-24 bg-cream border-b border-black/[0.06]"><div class="max-w-5xl mx-auto px-4"><p class="type-eyebrow text-ink-faint text-center mb-5">Direct answers</p><h2 class="type-section-title text-ink text-center mb-14">What to know before you apply.</h2><div class="grid md:grid-cols-3 gap-px bg-black/[0.06] rounded-2xl overflow-hidden"><article class="bg-white p-7 md:p-8"><h3 class="type-ui text-ink mb-4">What is SPACE?</h3><p class="type-small text-ink-muted">SPACE is a direct music-rights buyer for independent catalog owners. It buys revenue-generating catalogs in ambient, lo-fi, meditation, electronic, house, wellness, and soundscape genres without using an auction marketplace.</p></article><article class="bg-white p-7 md:p-8"><h3 class="type-ui text-ink mb-4">Who qualifies?</h3><p class="type-small text-ink-muted">We review contactability, transferable rights and documented income individually. Start with a free review request; we confirm the evidence needed by email. No automatic minimum or guaranteed offer is implied.</p></article><article class="bg-white p-7 md:p-8"><h3 class="type-ui text-ink mb-4">How are offers priced?</h3><p class="type-small text-ink-muted">SPACE considers documented income, trends, platform mix, rights, contracts and track concentration. A calculator scenario is not an offer. The acquired share, payment conditions and actual price require individual review and agreement.</p></article></div></div></section><section class="py-24 md:py-32 bg-cream"><div class="max-w-3xl mx-auto px-4"><p class="type-eyebrow text-ink-faint text-center mb-5">The decision</p><h2 class="type-section-title text-ink text-center mb-5">Stream it. Or sell it.</h2><p class="type-body text-center text-ink-muted mb-14 measure-narrow mx-auto">Same catalog. Completely different outcome.</p><div class="rounded-2xl overflow-hidden border border-black/[0.07]"><div class="grid grid-cols-3 bg-cream border-b border-black/[0.07]"><div class="py-3.5 px-5 type-caption font-medium text-ink-faint uppercase"></div><div class="py-3.5 px-5 type-caption font-medium text-ink-faint uppercase">Keep streaming</div><div class="py-3.5 px-5 type-caption font-medium text-brand uppercase">Sell to SPACE</div></div><div class="grid grid-cols-3 bg-white border-b border-black/[0.05]"><div class="py-4 px-5 type-caption font-medium text-ink-faint uppercase">When</div><div class="py-4 px-5 type-small text-ink-muted font-normal">Over time</div><div class="py-4 px-5 type-small text-ink font-medium">After closing conditions</div></div><div class="grid grid-cols-3 bg-white border-b border-black/[0.05]"><div class="py-4 px-5 type-caption font-medium text-ink-faint uppercase">Amount</div><div class="py-4 px-5 type-small text-ink-muted font-normal">Your actual royalty receipts</div><div class="py-4 px-5 type-small text-ink font-medium">Individually agreed price</div></div><div class="grid grid-cols-3 bg-white border-b border-black/[0.05]"><div class="py-4 px-5 type-caption font-medium text-ink-faint uppercase">Certainty</div><div class="py-4 px-5 type-small text-ink-muted font-normal">Revenue fluctuates</div><div class="py-4 px-5 type-small text-ink font-medium">Terms agreed in writing</div></div><div class="grid grid-cols-3 bg-white border-b border-black/[0.05]"><div class="py-4 px-5 type-caption font-medium text-ink-faint uppercase">Overhead</div><div class="py-4 px-5 type-small text-ink-muted font-normal">Admin, taxes, accounting</div><div class="py-4 px-5 type-small text-ink font-medium">Responsibilities set in the agreement</div></div><div class="grid grid-cols-3 bg-white "><div class="py-4 px-5 type-caption font-medium text-ink-faint uppercase">Focus</div><div class="py-4 px-5 type-small text-ink-muted font-normal">Split across old + new music</div><div class="py-4 px-5 type-small text-ink font-medium">Confirm retained and future rights</div></div></div><p class="text-center mt-8"><a class="type-small text-brand hover:underline underline-offset-4 font-medium" href="/guides/how-to-sell-music-rights/">Read the complete selling guide →</a></p></div></section><section class="py-24 md:py-32 bg-white"><div class="max-w-5xl mx-auto px-4"><p class="text-[11px] font-light text-ink-faint uppercase tracking-[0.3em] text-center mb-5">Process</p><h2 class="font-display text-3xl md:text-5xl font-semibold tracking-tight text-ink text-center mb-20 leading-[1.05]">Three steps. That's it.</h2><div class="grid md:grid-cols-3 gap-px bg-black/[0.06] rounded-2xl overflow-hidden"><div class="bg-white p-8 md:p-10"><p class="text-4xl font-display font-semibold text-black/10 mb-6 leading-none tabular-nums">01</p><h3 class="text-base font-semibold text-ink mb-3">Submit your catalog</h3><p class="text-sm text-ink-muted leading-relaxed font-light">Start with your email and artist or label name. We follow up by email to request the relevant streaming links, royalty statements and rights documents privately.</p></div><div class="bg-white p-8 md:p-10"><p class="text-4xl font-display font-semibold text-black/10 mb-6 leading-none tabular-nums">02</p><h3 class="text-base font-semibold text-ink mb-3">Get your offer</h3><p class="text-sm text-ink-muted leading-relaxed font-light">We review documented income and the rights offered. If the catalog is a fit, an initial offer typically follows within 5-7 business days after the relevant information is received.</p></div><div class="bg-white p-8 md:p-10"><p class="text-4xl font-display font-semibold text-black/10 mb-6 leading-none tabular-nums">03</p><h3 class="text-base font-semibold text-ink mb-3">Get paid</h3><p class="text-sm text-ink-muted leading-relaxed font-light">Review the agreement with an independent adviser. Payment follows the completed agreement and satisfied rights-transfer conditions. Confirm what stays yours, including future work.</p></div></div><div class="text-center mt-10"><a href="/apply/" class="inline-flex items-center gap-2 bg-brand text-white font-medium px-7 py-3.5 text-sm rounded-full hover:bg-brand-hover transition-colors">Request a free catalog review<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></section><section class="py-24 md:py-32 bg-cream"><div class="max-w-5xl mx-auto px-4"><p class="type-eyebrow text-ink-faint text-center mb-5">What we buy</p><h2 class="type-section-title text-ink text-center mb-5">Genres we acquire.</h2><p class="type-body text-center text-ink-muted mb-6 measure mx-auto">From mood catalogs to commercial electronic rights, we evaluate catalogs with real demand across streaming, creator channels, wellness apps, and licensing.</p><p class="type-small text-center text-ink-faint mb-14 measure mx-auto">New expansion includes Deep House, Melodic House, Progressive House, Tech House, Techno, Melodic Techno, Trance, Drum &amp; Bass.</p><div class="grid sm:grid-cols-2 md:grid-cols-3 gap-px bg-black/[0.06] rounded-2xl overflow-hidden max-w-5xl mx-auto"><a class="group bg-white p-7 hover:bg-cream transition-colors duration-200" href="/sell/"><div class="flex items-start justify-between mb-3"><h3 class="type-ui text-ink">Ambient</h3><span class="type-caption font-medium text-brand ml-3 whitespace-nowrap mt-0.5">Review</span></div><p class="type-small text-ink-muted font-normal">Atmospheric textures, drones, soundscapes</p></a><a class="group bg-white p-7 hover:bg-cream transition-colors duration-200" href="/sell/"><div class="flex items-start justify-between mb-3"><h3 class="type-ui text-ink">Lo-Fi</h3><span class="type-caption font-medium text-brand ml-3 whitespace-nowrap mt-0.5">Review</span></div><p class="type-small text-ink-muted font-normal">Beats and melodies for focus and study</p></a><a class="group bg-white p-7 hover:bg-cream transition-colors duration-200" href="/sell/"><div class="flex items-start justify-between mb-3"><h3 class="type-ui text-ink">Meditation</h3><span class="type-caption font-medium text-brand ml-3 whitespace-nowrap mt-0.5">Review</span></div><p class="type-small text-ink-muted font-normal">Mindfulness, sound healing, breathwork</p></a><a class="group bg-white p-7 hover:bg-cream transition-colors duration-200" href="/sell/"><div class="flex items-start justify-between mb-3"><h3 class="type-ui text-ink">Electronic</h3><span class="type-caption font-medium text-brand ml-3 whitespace-nowrap mt-0.5">Review</span></div><p class="type-small text-ink-muted font-normal">Broad electronic catalogs with licensing utility</p></a><a class="group bg-white p-7 hover:bg-cream transition-colors duration-200" href="/sell/"><div class="flex items-start justify-between mb-3"><h3 class="type-ui text-ink">House</h3><span class="type-caption font-medium text-brand ml-3 whitespace-nowrap mt-0.5">Review</span></div><p class="type-small text-ink-muted font-normal">Deep, melodic, progressive, and tech-house rights</p></a><a class="group bg-white p-7 hover:bg-cream transition-colors duration-200" href="/sell/"><div class="flex items-start justify-between mb-3"><h3 class="type-ui text-ink">Tropical House</h3><span class="type-caption font-medium text-brand ml-3 whitespace-nowrap mt-0.5">Review</span></div><p class="type-small text-ink-muted font-normal">Melodic dance catalogs for travel and lifestyle media</p></a><a class="group bg-white p-7 hover:bg-cream transition-colors duration-200" href="/sell/"><div class="flex items-start justify-between mb-3"><h3 class="type-ui text-ink">Focus</h3><span class="type-caption font-medium text-brand ml-3 whitespace-nowrap mt-0.5">Review</span></div><p class="type-small text-ink-muted font-normal">Instrumental music for deep work</p></a><a class="group bg-white p-7 hover:bg-cream transition-colors duration-200" href="/sell/"><div class="flex items-start justify-between mb-3"><h3 class="type-ui text-ink">Nature Soundscapes</h3><span class="type-caption font-medium text-brand ml-3 whitespace-nowrap mt-0.5">Review</span></div><p class="type-small text-ink-muted font-normal">Field recordings, environmental audio</p></a><a class="group bg-white p-7 hover:bg-cream transition-colors duration-200" href="/sell/"><div class="flex items-start justify-between mb-3"><h3 class="type-ui text-ink">Wellness</h3><span class="type-caption font-medium text-brand ml-3 whitespace-nowrap mt-0.5">Review</span></div><p class="type-small text-ink-muted font-normal">Yoga, spa, sleep, therapeutic audio</p></a></div><div class="text-center mt-8"><a class="type-small inline-flex items-center gap-2 text-brand hover:underline underline-offset-4 font-medium" href="/sell/">Explore all genre pages and subgenres<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></section><section class="py-24 md:py-32 bg-brand"><div class="max-w-2xl mx-auto px-4 text-center"><p class="type-eyebrow text-white/75 mb-5">If you need the number first</p><h2 class="type-section-title text-white mb-5">Explore a hypothetical catalog sale.</h2><p class="type-body text-white/88 mb-10 measure-narrow mx-auto">Monthly net income x 12 x your assumed multiple x the share sold = <strong class="text-white font-medium">your scenario</strong>. Choose your own assumptions. This is not a market valuation, payment date or SPACE offer.</p><a class="type-ui inline-flex items-center gap-2 bg-white text-brand px-7 py-3.5 rounded-full hover:bg-cream transition-colors" href="/calculator/">Explore a sale scenario<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></section><section id="faq" class="py-20 md:py-28 bg-cream"><div class="max-w-3xl mx-auto px-4"><p class="text-[11px] font-normal text-ink-faint uppercase tracking-[0.3em] text-center mb-5">Questions</p><h2 class="font-display text-3xl md:text-5xl font-semibold tracking-tight text-ink text-center mb-16 leading-[1.05]">Everything you want to know.</h2><div class="w-full" data-orientation="vertical"><div data-state="closed" data-orientation="vertical" class="border-b border-black/10"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:r1:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:r0:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-base font-medium py-5 hover:no-underline text-left text-ink" data-radix-collection-item="">What kind of music catalogs does SPACE buy?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:r1:" hidden="" role="region" aria-labelledby="radix-:r0:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-black/10"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:r3:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:r2:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-base font-medium py-5 hover:no-underline text-left text-ink" data-radix-collection-item="">How does the process work?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:r3:" hidden="" role="region" aria-labelledby="radix-:r2:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-black/10"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:r5:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:r4:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-base font-medium py-5 hover:no-underline text-left text-ink" data-radix-collection-item="">Can I sell only part of my catalog?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:r5:" hidden="" role="region" aria-labelledby="radix-:r4:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-black/10"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:r7:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:r6:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-base font-medium py-5 hover:no-underline text-left text-ink" data-radix-collection-item="">What do I need to qualify?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:r7:" hidden="" role="region" aria-labelledby="radix-:r6:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-black/10"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:r9:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:r8:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-base font-medium py-5 hover:no-underline text-left text-ink" data-radix-collection-item="">Do I lose creative control?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:r9:" hidden="" role="region" aria-labelledby="radix-:r8:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-black/10"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:rb:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:ra:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-base font-medium py-5 hover:no-underline text-left text-ink" data-radix-collection-item="">How is my catalog valued?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:rb:" hidden="" role="region" aria-labelledby="radix-:ra:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-black/10"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:rd:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:rc:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-base font-medium py-5 hover:no-underline text-left text-ink" data-radix-collection-item="">How long does the process take?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:rd:" hidden="" role="region" aria-labelledby="radix-:rc:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);"></div></div><div data-state="closed" data-orientation="vertical" class="border-b border-black/10"><h3 data-orientation="vertical" data-state="closed" class="flex"><button type="button" aria-controls="radix-:rf:" aria-expanded="false" data-state="closed" data-orientation="vertical" id="radix-:re:" class="flex flex-1 items-center justify-between transition-all [&amp;[data-state=open]&gt;svg]:rotate-180 text-base font-medium py-5 hover:no-underline text-left text-ink" data-radix-collection-item="">What payment methods do you support?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div data-state="closed" id="radix-:rf:" hidden="" role="region" aria-labelledby="radix-:re:" data-orientation="vertical" class="overflow-hidden text-sm transition-all data-[state=closed]:animate-accordion-up data-[state=open]:animate-accordion-down" style="--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);"></div></div></div></div></section><section class="py-24 md:py-32 bg-dark text-white"><div class="max-w-2xl mx-auto px-4 text-center"><h2 class="type-section-title mb-5">Considering selling your music catalog?</h2><p class="type-body text-white/84 mb-12 measure-narrow mx-auto">Request a free individual review. Understand the rights, evidence and terms before deciding whether to sell.</p><div class="flex flex-col sm:flex-row items-center justify-center gap-3"><a href="/apply/" class="type-ui inline-flex items-center gap-2 bg-brand text-white px-8 py-4 rounded-full hover:bg-brand-hover transition-colors">Request a free catalog review<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="type-ui inline-flex items-center gap-2 text-white/80 px-8 py-4 rounded-full hover:text-white transition-colors" href="/calculator/">See the numbers first ›</a></div><p class="type-caption text-white/68 mt-8">Free evaluation · No commitment · Your data stays private</p></div></section></main><footer class="bg-dark"><div class="max-w-5xl mx-auto px-4 py-20"><div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-10"><div class="space-y-8 md:col-span-5 min-w-0"><div class="space-y-2"><a class="font-display text-[1.375rem] font-semibold text-white tracking-[-0.04em]" href="/">SPACE</a><p class="type-small text-white/78 measure-narrow">We review revenue-generating music catalogs directly, across genres.</p></div><div class="space-y-3"><p class="type-caption text-white/65 uppercase font-medium">The Catalog Report</p><p class="type-small text-white/72">Bi-weekly market insights and creator tips.</p><form class="flex flex-wrap gap-2"><input type="email" placeholder="you@email.com" required="" class="type-small flex-grow min-w-0 px-3 py-2 rounded-full text-white placeholder-white/55 focus:outline-none focus:border-white/50 transition-colors" value="" style="background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12);"><button type="submit" class="type-small px-4 py-2 bg-brand text-white rounded-full hover:bg-brand-hover transition-colors disabled:opacity-50 font-medium whitespace-nowrap shrink-0">Subscribe</button></form></div></div><nav class="flex flex-col gap-4 md:col-span-3"><span class="type-caption font-medium text-white/65 uppercase">Explore</span><ul class="flex flex-col gap-2.5"><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/how-it-works/">How It Works</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/sell/">Sell Your Catalog</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/calculator/">Calculator</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/about/">About</a></li><li><a href="/apply/" class="type-small text-white/80 hover:text-white transition-colors">Request a free catalog review</a></li></ul></nav><nav class="flex flex-col gap-4 md:col-span-4"><span class="type-caption font-medium text-white/65 uppercase">Learn</span><ul class="flex flex-col gap-2.5"><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/guides/how-to-sell-music-rights/">Selling Guide</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/guides/music-rights-101/">Music Rights 101</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/guides/music-catalog-valuation-2026/">Valuation Guide</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/guides/what-are-your-streams-worth-2026/">Streams Worth</a></li></ul></nav></div><div class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"><div class="flex items-center gap-6"><p class="type-caption text-white/70">© 2026 SPACE. All rights reserved.</p><a class="type-caption text-white/65 hover:text-white/90 transition-colors" href="/privacy/">Privacy</a><a href="mailto:hello@spacemusic.io" class="type-caption text-white/70 hover:text-white transition-colors">hello@spacemusic.io</a></div><div class="flex gap-5"><a href="#" aria-label="Twitter" class="text-white/70 hover:text-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter h-4 w-4"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg></a><a href="#" aria-label="LinkedIn" class="text-white/70 hover:text-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin h-4 w-4"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg></a></div></div></div></footer><div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-2rem)] max-w-lg"><div class="bg-white/[0.06] border border-white/10 rounded-2xl px-5 py-4 shadow-2xl shadow-black/40 backdrop-blur-xl flex flex-col sm:flex-row sm:items-center gap-4 justify-between"><p class="text-[13px] text-ink-muted leading-relaxed">We use cookies to improve your experience.</p><div class="flex gap-2 flex-shrink-0"><button class="text-[13px] font-medium px-4 py-2 rounded-full bg-white text-ink hover:bg-cream-dark transition-colors whitespace-nowrap">Accept</button><button class="text-[13px] font-light px-4 py-2 rounded-full border border-white/20 text-ink-muted hover:text-white hover:border-white/40 transition-colors whitespace-nowrap">Decline</button></div></div></div></div></div>
  <script data-space-seo-links="true">
(() => {
  const normalizeInternalLinks = () => {
    document.querySelectorAll('a[href^="/"]').forEach((anchor) => {
      const href = anchor.getAttribute('href');
      if (!href || href === '/' || href.startsWith('/#') || href.startsWith('/assets/')) return;
      const url = new URL(href, window.location.origin);
      if (url.pathname.endsWith('/') || /\.[^/]+$/.test(url.pathname)) return;
      anchor.setAttribute('href', url.pathname + '/' + url.search + url.hash);
    });
  };
  normalizeInternalLinks();
  new MutationObserver(normalizeInternalLinks).observe(document.documentElement, {childList: true, subtree: true});
})();
</script>
  

</body></html>