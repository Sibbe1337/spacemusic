r:nth-child(9){animation-delay:-.4s;transform:rotate(240deg) translate(146%)}.sonner-loading-bar:nth-child(10){animation-delay:-.3s;transform:rotate(270deg) translate(146%)}.sonner-loading-bar:nth-child(11){animation-delay:-.2s;transform:rotate(300deg) translate(146%)}.sonner-loading-bar:nth-child(12){animation-delay:-.1s;transform:rotate(330deg) translate(146%)}@keyframes sonner-fade-in{0%{opacity:0;transform:scale(.8)}to{opacity:1;transform:scale(1)}}@keyframes sonner-fade-out{0%{opacity:1;transform:scale(1)}to{opacity:0;transform:scale(.8)}}@keyframes sonner-spin{0%{opacity:1}to{opacity:.15}}@media (prefers-reduced-motion){[data-sonner-toast],[data-sonner-toast]>*,.sonner-loading-bar{transition:none!important;animation:none!important}}.sonner-loader{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);transform-origin:center;transition:opacity .2s,transform .2s}.sonner-loader[data-visible=false]{opacity:0;transform:scale(.8) translate(-50%,-50%)}
</style><link rel="modulepreload" as="script" crossorigin="" href="/assets/Calculator-scenario-a3cd3270b5bd-journey-396b323aebc9.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/Navbar-DK5bZPep-journey-396b323aebc9.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/Footer-CiCbq8u0-journey-396b323aebc9.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/SEOHead-C4J8_WVH.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/accordion-DNmmZSWQ.js"><meta name="description" content="Calculate a hypothetical catalog sale from monthly net income, your assumed multiple and the share sold. Request a free individual catalog review." data-rh="true"><meta property="og:title" content="Music Catalog Value Calculator: Build a Sale Scenario" data-rh="true"><meta property="og:description" content="Calculate a hypothetical catalog sale from monthly net income, your assumed multiple and the share sold. Request a free individual catalog review." data-rh="true"><meta name="twitter:title" content="Music Catalog Value Calculator: Build a Sale Scenario" data-rh="true"><meta name="twitter:description" content="Calculate a hypothetical catalog sale from monthly net income, your assumed multiple and the share sold. Request a free individual catalog review." data-rh="true"><script id="seo-schema-0" type="application/ld+json" data-rh="true">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://spacemusic.io/"},{"@type":"ListItem","position":2,"name":"Music Catalog Value Calculator: Build a Sale Scenario","item":"https://spacemusic.io/calculator/"}]}</script><link rel="stylesheet" href="/assets/journey-cta-632796e93c26.css"></head>

  <body>
    <div id="root"><div role="region" aria-label="Notifications (F8)" tabindex="-1" style="pointer-events: none;"><ol tabindex="-1" class="fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]"></ol></div><div class="min-h-screen flex flex-col bg-cream"><nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-cream/80 backdrop-blur-md"><div class="max-w-5xl mx-auto px-6 sm:px-8"><div class="flex items-center justify-between h-[4.5rem]"><a class="flex items-center gap-2.5 group" aria-label="SPACE — home" href="/"><span class="text-ink transition-opacity duration-200 group-hover:opacity-60"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="flex-shrink-0"><rect x="0" y="0" width="5" height="5" rx="1" fill="currentColor" opacity="0.9"></rect><rect x="7" y="0" width="5" height="5" rx="1" fill="currentColor" opacity="0.5"></rect><rect x="13" y="0" width="5" height="5" rx="1" fill="currentColor" opacity="0.25"></rect><rect x="0" y="7" width="5" height="5" rx="1" fill="currentColor" opacity="0.5"></rect><rect x="7" y="7" width="5" height="5" rx="1" fill="currentColor" opacity="0.9"></rect><rect x="13" y="7" width="5" height="5" rx="1" fill="currentColor" opacity="0.5"></rect><rect x="0" y="13" width="5" height="5" rx="1" fill="currentColor" opacity="0.25"></rect><rect x="7" y="13" width="5" height="5" rx="1" fill="currentColor" opacity="0.5"></rect><rect x="13" y="13" width="5" height="5" rx="1" fill="currentColor" opacity="0.9"></rect></svg></span><span class="text-ink font-display font-semibold tracking-[-0.03em] text-[1.0625rem] transition-opacity duration-200 group-hover:opacity-60">SPACE</span></a><div class="hidden md:flex items-center gap-8"><a class="type-ui transition-colors duration-200 font-normal text-ink-muted hover:text-ink" href="/how-it-works/">How It Works</a><a class="type-ui transition-colors duration-200 font-normal text-ink-muted hover:text-ink" href="/sell/">Sell</a><a class="type-ui transition-colors duration-200 font-medium text-ink" aria-current="page" href="/calculator/">Calculator</a><a class="type-ui px-5 py-2 rounded-full bg-brand text-white hover:bg-brand-hover transition-colors duration-200" href="/apply/">Request a free catalog review</a></div><button class="md:hidden p-2 -mr-1 text-ink-muted hover:text-ink transition-colors" aria-label="Open menu"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu h-[18px] w-[18px]"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg></button></div></div><div class="md:hidden overflow-hidden transition-all duration-300 ease-out max-h-0 opacity-0"><div class="border-t border-black/[0.08] bg-cream/98 backdrop-blur-2xl px-6 py-5"><div class="flex flex-col gap-0.5"><a class="type-ui py-3.5 transition-colors font-normal text-ink-muted hover:text-ink" href="/how-it-works/">How It Works</a><a class="type-ui py-3.5 transition-colors font-normal text-ink-muted hover:text-ink" href="/sell/">Sell</a><a class="type-ui py-3.5 transition-colors font-medium text-ink" aria-current="page" href="/calculator/">Calculator</a><div class="pt-4 mt-3 border-t border-black/[0.08] space-y-2"><a class="type-ui block text-center px-5 py-2.5 rounded-full bg-brand text-white hover:bg-brand-hover transition-colors" href="/apply/">Request a free catalog review</a></div></div></div></div></nav><section class="pt-28 pb-12 md:pt-36 md:pb-14"><div class="max-w-4xl mx-auto px-6 text-center"><p class="text-xs font-normal tracking-[0.25em] text-ink-faint uppercase mb-6">Free tool</p><h1 class="font-display text-4xl md:text-6xl tracking-tight text-ink leading-[1.05] mb-4">Your catalog is worth more than monthly royalties.</h1><p class="text-sm md:text-base text-ink-muted font-normal max-w-2xl mx-auto leading-relaxed">Explore a hypothetical sale using your monthly net income and an assumed multiple you choose. This is not a market valuation or a SPACE offer.</p></div></section><section class="pb-20"><div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-[1.1fr_0.9fr] gap-6 lg:gap-8 items-start"><div class="bg-white border border-black/10 rounded-3xl p-6 md:p-8"><p class="text-xs uppercase tracking-[0.18em] text-ink-faint mb-3">Scenario inputs (USD)</p><div class="flex flex-wrap gap-2 mb-8"><button type="button" aria-pressed="true" class="px-3 py-1.5 rounded-full text-xs border bg-brand-light text-ink border-brand/30">Enter monthly net income</button><button type="button" aria-pressed="false" class="px-3 py-1.5 rounded-full text-xs border bg-white text-ink-muted border-black/10">Calculate net income from receipts</button></div><label class="block text-sm text-ink-muted mb-6">Monthly net income (USD)<input class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3 py-2 text-sm text-ink" type="number" inputmode="decimal" min="0" step="any" value=""></label><label class="block text-sm text-ink-muted mb-6">Assumed annual-income multiple<input class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3 py-2 text-sm text-ink" type="number" inputmode="decimal" min="0" step="any" aria-describedby="multiple-help" value=""></label><p id="multiple-help" class="text-xs text-ink-muted mb-8">Choose your own positive assumption. No market multiple is supplied. A multiple is not a number of years to multiply again, nor the legal term of a sale.</p><label class="block text-sm text-ink-muted mb-6">Share of defined rights to sell (%)<input class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3 py-2 text-sm text-ink" type="number" inputmode="decimal" min="0" step="any" max="100" aria-describedby="share-help" value="70"></label><input type="range" aria-label="Adjust share to sell" min="0" max="100" step="1" class="w-full" value="70"><p id="share-help" class="text-xs text-ink-muted mt-3">Use 0-100% of the rights represented by your net income. Do not subtract the sold share from the income first; the formula applies it once.</p></div><aside class="lg:sticky lg:top-24 bg-dark rounded-3xl p-6 md:p-8 text-white border border-white/10"><h2 class="text-sm uppercase tracking-[0.2em] text-white/75 mb-4">Hypothetical sale scenario</h2><div role="status" aria-live="polite" aria-atomic="true" class="mb-6" data-scenario-result="true"><p class="text-base text-white/80">Enter valid income, a positive assumed multiple and a share from 0-100% to see a scenario. Zero income is allowed.</p></div><p class="text-sm text-white/80 mb-7">Not a market value, guaranteed price or SPACE offer. This arithmetic does not price risk, taxes, fees, recoupment or transfer conditions.</p><a href="/apply/" class="inline-flex items-center justify-center gap-2 bg-brand text-white font-medium px-8 py-3.5 text-base rounded-full hover:bg-brand-hover transition-colors w-full">Request a free catalog review</a><p class="text-xs text-white/80 text-center mt-3">Free evaluation. No obligation.</p><div class="mt-7 pt-6 border-t border-white/10"><h3 class="text-sm mb-3">How this is calculated</h3><p class="text-sm text-white/80 leading-relaxed">Monthly net income x 12 x assumed multiple x share sold. There is no extra years multiplier and no predicted price range.</p></div></aside></div></section><section class="border-t border-black/10 py-20"><div class="max-w-3xl mx-auto px-6 text-sm text-ink-muted leading-relaxed"><h2 class="font-display text-3xl text-ink mb-6">Gross revenue, net income and the rights sold</h2><p class="mb-4">Gross revenue is before relevant deductions. Distributor receipts may already exclude some fees. Net income here means the income attributable to the defined rights after applicable distributor fees, third-party royalty payouts and operating costs. Avoid deducting an expense twice, and use one currency and a representative period.</p><p class="mb-4">Sound recording rights and composition rights are distinct. Only include income attributable to rights you own and can transfer. Selling part of your share is not the same as selling that percentage of the entire catalog. Outstanding advances, co-owner permissions and existing agreements need a separate review.</p><p>Read the <a class="underline text-ink" href="/guides/music-catalog-valuation-2026/">music catalog valuation guide</a> for the factors beyond this calculation.</p></div></section><section class="border-t border-black/10 py-20"><div class="max-w-xl mx-auto px-6"><h2 class="text-xs tracking-[0.2em] text-ink-faint uppercase mb-10">Questions</h2><details class="border-b border-black/10"><summary class="text-sm text-ink py-5 cursor-pointer">How is my catalog valued?</summary><p class="text-sm text-ink-muted pb-5 leading-relaxed">An individual review considers documented income, the rights you can transfer, contracts and the risks attached to future earnings. This tool only calculates the assumptions you enter. It does not supply a market multiple or a SPACE offer.</p></details><details class="border-b border-black/10"><summary class="text-sm text-ink py-5 cursor-pointer">What does the 'share to sell' slider mean?</summary><p class="text-sm text-ink-muted pb-5 leading-relaxed">It is the percentage of the defined rights and income represented by your inputs that you would sell, not automatically a percentage of every right in every recording and composition. A partial sale may be possible, subject to ownership and agreement.</p></details><details class="border-b border-black/10"><summary class="text-sm text-ink py-5 cursor-pointer">How quickly will I get paid?</summary><p class="text-sm text-ink-muted pb-5 leading-relaxed">SPACE typically provides an initial offer within 5-7 business days after receiving the relevant information, if the catalog is a fit. Payment is by bank transfer after the agreement is complete and transfer conditions are satisfied. The calculator does not promise a payment date.</p></details><details class="border-b border-black/10"><summary class="text-sm text-ink py-5 cursor-pointer">Can I sell only specific tracks?</summary><p class="text-sm text-ink-muted pb-5 leading-relaxed">You can propose specific tracks, albums or a share of defined rights for review. The transferable scope, retained rights and any consent requirements must be confirmed before a sale.</p></details></div></section><section class="border-t border-black/10 bg-dark py-24 md:py-32"><div class="max-w-3xl mx-auto px-6 text-center"><h2 class="text-3xl md:text-5xl font-display font-semibold tracking-tight text-white mb-6">Ready for an individual review?</h2><p class="text-white/82 mb-10">If your catalog is a fit, an initial offer typically follows within 5-7 business days after we receive the relevant information. Payment follows the completed agreement and satisfied transfer conditions.</p><a href="/apply/" class="inline-flex items-center justify-center gap-2 bg-brand text-white font-medium px-8 py-3.5 text-base rounded-full hover:bg-brand-hover transition-colors">Request a free catalog review</a></div></section><footer class="bg-dark"><div class="max-w-5xl mx-auto px-4 py-20"><div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-10"><div class="space-y-8 md:col-span-5 min-w-0"><div class="space-y-2"><a class="font-display text-[1.375rem] font-semibold text-white tracking-[-0.04em]" href="/">SPACE</a><p class="type-small text-white/78 measure-narrow">We review revenue-generating music catalogs directly, across genres.</p></div><div class="space-y-3"><p class="type-caption text-white/65 uppercase font-medium">The Catalog Report</p><p class="type-small text-white/72">Bi-weekly market insights and creator tips.</p><form class="flex flex-wrap gap-2"><input type="email" placeholder="you@email.com" required="" class="type-small flex-grow min-w-0 px-3 py-2 rounded-full text-white placeholder-white/55 focus:outline-none focus:border-white/50 transition-colors" value="" style="background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12);"><button type="submit" class="type-small px-4 py-2 bg-brand text-white rounded-full hover:bg-brand-hover transition-colors disabled:opacity-50 font-medium whitespace-nowrap shrink-0">Subscribe</button></form></div></div><nav class="flex flex-col gap-4 md:col-span-3"><span class="type-caption font-medium text-white/65 uppercase">Explore</span><ul class="flex flex-col gap-2.5"><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/how-it-works/">How It Works</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/sell/">Sell Your Catalog</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/calculator/">Calculator</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/about/">About</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/apply/">Request a free catalog review</a></li></ul></nav><nav class="flex flex-col gap-4 md:col-span-4"><span class="type-caption font-medium text-white/65 uppercase">Learn</span><ul class="flex flex-col gap-2.5"><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/guides/how-to-sell-music-rights/">Selling Guide</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/guides/music-rights-101/">Music Rights 101</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/guides/music-catalog-valuation-2026/">Valuation Guide</a></li><li><a class="type-small text-white/80 hover:text-white transition-colors" href="/guides/what-are-your-streams-worth-2026/">Streams Worth</a></li></ul></nav></div><div class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"><div class="flex items-center gap-6"><p class="type-caption text-white/70">© 2026 SPACE. All rights reserved.</p><a class="type-caption text-white/65 hover:text-white/90 transition-colors" href="/privacy/">Privacy</a><a href="mailto:hello@spacemusic.io" class="type-caption text-white/70 hover:text-white transition-colors">hello@spacemusic.io</a></div><div class="flex gap-5"><a href="#" aria-label="Twitter" class="text-white/70 hover:text-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter h-4 w-4"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg></a><a href="#" aria-label="LinkedIn" class="text-white/70 hover:text-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin h-4 w-4"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg></a></div></div></div></footer></div></div>
  <script data-space-seo-links="true">
(() => {
  const normalizeInternalLinks = () => {
    document.querySelectorAll('a[href^="/"]').forEach((anchor) => {
      const href = anchor.getAttribute('href');
      if (!href || href === '/' || href.startsWith('/#') || href.startsWith('/assets/')) return;
      const url = new URL(href, window.location.origin);
      if (url.pathname.endsWith('/') || /\.[^/]+$/.test(url.pathname)) return;
      anchor.setAttribute('href', url.pathname + '/' + url.search + url.hash);
    });
  };
  normalizeInternalLinks();
  new MutationObserver(normalizeInternalLinks).observe(document.documentElement, {childList: true, subtree: true});
})();
</script>
  

<noscript><p style="padding:24px">JavaScript is needed for the interactive calculation. Use the formula above or <a href="/apply/">request a free catalog review</a>.</p></noscript></body></html>