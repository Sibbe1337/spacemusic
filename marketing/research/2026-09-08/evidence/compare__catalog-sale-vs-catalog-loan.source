ll-psytrance-catalog/","/sell/sell-sleep-music-catalog/","/sell/sell-study-beats-catalog/","/sell/sell-synthwave-catalog/","/sell/sell-tech-house-catalog/","/sell/sell-techno-catalog/","/sell/sell-trance-catalog/","/sell/sell-tropical-house-catalog/","/sell/sell-uk-garage-catalog/","/sell/sell-wellness-music-catalog/","/blog/what-is-a-blanket-license/","/blog/sell-music-catalog-lump-sum-2026/","/blog/ambient-lo-fi-music-catalog-buyers/","/blog/royalty-exchange-alternatives/","/blog/beatbread-vs-catalog-buyers/","/blog/music-catalog-sale-documents-checklist/","/blog/music-catalog-offer-checklist/"]),i=new Set(["calculator_used","apply_clicked","application_started","application_submitted"]),p="space.funnel.v1.",n={};function l(e){if(typeof e!="string"||!e.startsWith("/")||/[?#\\]/.test(e))return"";const s=e==="/"||/\.[a-z]+$/i.test(e)?e:e.replace(/\/$/,"")+"/";return f.has(s)?s:""}function r(e){try{return sessionStorage.getItem(p+e)||n[e]||""}catch{return n[e]||""}}function c(e,s){n[e]=s;try{sessionStorage.setItem(p+e,s)}catch{}}function m(){const e={};for(const s of["landing_path","apply_source_path"]){const a=l(r(s));a&&(e[s]=a)}return e}const u=l(location.pathname);if(u&&!l(r("landing_path"))&&c("landing_path",u),u==="/apply/"&&!l(r("apply_source_path")))try{const e=new URL(document.referrer);if(e.origin===location.origin){const s=l(e.pathname);s&&s!=="/apply/"&&c("apply_source_path",s)}}catch{}function g(e){try{i.has(e)&&l(location.pathname)&&window.plausible?.(e,{props:m()})}catch{}}function y(e){!i.has(e)||r("sent."+e)||(c("sent."+e,"1"),g(e))}function h(e){try{if(!["spacemusic.io","www.spacemusic.io"].includes(location.hostname)||!["pageview","engagement",...i].includes(e.n))return null;const s=l(new URL(e.u).pathname);if(!s)return null;const a={};if(i.has(e.n))for(const o of["landing_path","apply_source_path"]){const d=l(e.p?.[o]);d&&(a[o]=d)}let t="";if(e.r){const o=new URL(e.r);/^https?:$/.test(o.protocol)&&(t=o.origin)}return{n:e.n,u:"https://spacemusic.io