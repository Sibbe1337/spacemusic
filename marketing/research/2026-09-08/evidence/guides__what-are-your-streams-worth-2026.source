hite/70 hover:text-white transition-colors">hello@spacemusic.io</a></div><div class="flex gap-5"><a href="#" aria-label="Twitter" class="text-white/70 hover:text-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter h-4 w-4"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg></a><a href="#" aria-label="LinkedIn" class="text-white/70 hover:text-white transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin h-4 w-4"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg></a></div></div></div></footer></div></div>
  <script data-space-seo-links="true">
(() => {
  const normalizeInternalLinks = () => {
    document.querySelectorAll('a[href^="/"]').forEach((anchor) => {
      const href = anchor.getAttribute('href');
      if (!href || href === '/' || href.startsWith('/#') || href.startsWith('/assets/')) return;
      const url = new URL(href, window.location.origin);
      if (url.pathname.endsWith('/') || /\.[^/]+$/.test(url.pathname)) return;
      anchor.setAttribute('href', url.pathname + '/' + url.search + url.hash);
    });
  };
  normalizeInternalLinks();
  new MutationObserver(normalizeInternalLinks).observe(document.documentElement, {childList: true, subtree: true});
})();
</script>
  

</body></html>