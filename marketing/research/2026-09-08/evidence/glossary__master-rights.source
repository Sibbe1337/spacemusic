<script data-rh="true" id="seo-schema-0" type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://spacemusic.io/"},{"@type":"ListItem","position":2,"name":"Glossary","item":"https://spacemusic.io/glossary/"},{"@type":"ListItem","position":3,"name":"Master Rights","item":"https://spacemusic.io/glossary/master-rights/"}]}</script>
<script data-rh="true" id="seo-schema-1" type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the difference between master rights and publishing rights?","acceptedAnswer":{"@type":"Answer","text":"Master rights cover the specific sound recording, while publishing rights cover the underlying musical composition (melody, lyrics, arrangement). A single composition can have many different master recordings, each with its own master rights holder."}},{"@type":"Question","name":"Can I sell my master rights while keeping publishing rights?","acceptedAnswer":{"@type":"Answer","text":"Yes, master rights and publishing rights are separate assets and can be sold independently. Many artists sell their masters to generate immediate capital while retaining publishing to continue earning from compositions."}},{"@type":"Question","name":"Do I automatically own my masters if I record at home?","acceptedAnswer":{"@type":"Answer","text":"Generally yes — if you fund the recording yourself and have no contractual obligations to a label, you own the master rights. However, if collaborators or session musicians are involved, you should have written agreements clarifying ownership."}}]}</script><link rel="stylesheet" href="/assets/journey-cta-632796e93c26.css"></head>

