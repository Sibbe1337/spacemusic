</style><link rel="modulepreload" as="script" crossorigin="" href="/assets/BlogPost-article-f1c64c21fe43-journey-396b323aebc9.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/Navbar-DK5bZPep-journey-396b323aebc9.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/Footer-CiCbq8u0-journey-396b323aebc9.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/CookieBanner-BhC_lodR.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/button-Kc_XA-7I.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/SEOHead-C4J8_WVH.js"><link rel="modulepreload" as="script" crossorigin="" href="/assets/breadcrumbSchema-ClfraVQe.js"><link rel="canonical" href="https://spacemusic.io/blog/music-catalog-offer-checklist/" data-rh="true"><meta name="description" content="Compare music catalog offers by rights, term, net proceeds, payment conditions and retained obligations. Questions to take to independent legal review." data-rh="true"><meta property="og:title" content="Music Catalog Offer Checklist: Before You Sign | SPACE" data-rh="true"><meta property="og:description" content="Compare music catalog offers by rights, term, net proceeds, payment conditions and retained obligations. Questions to take to independent legal review." data-rh="true"><meta property="og:url" content="https://spacemusic.io/blog/music-catalog-offer-checklist/" data-rh="true"><meta property="og:type" content="article" data-rh="true"><meta property="og:image" content="https://spacemusic.io/social/space-catalog-v1.png" data-rh="true"><meta name="twitter:card" content="summary_large_image" data-rh="true"><meta name="twitter:title" content="Music Catalog Offer Checklist: Before You Sign | SPACE" data-rh="true"><meta name="twitter:description" content="Compare music catalog offers by rights, term, net proceeds, payment conditions and retained obligations. Questions to take to independent legal review." data-rh="true"><meta name="twit