	},
	"dependencies": {
		"axios": "^1.9.0",
		"date-fns": "^4.1.0",
		"lucide-react": "^0.511.0",
		"react-router-dom": "^7.6.0",
		"atmn": "^2.0.142"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"jsdom": "^26.1.0",
		"vitest": "^3.1.4"
	},
	"atmn": {
		"config": "autumn/autumn.config.ts"
	}
}
