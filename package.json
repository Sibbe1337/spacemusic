{
	"scripts": {
		"project:check": "node scripts/maintenance/project-check.mjs",
		"clean:check": "node scripts/maintenance/clean-caches.mjs",
		"clean:caches": "node scripts/maintenance/clean-caches.mjs --apply",
		"test:maintenance": "node --test scripts/maintenance/*.test.mjs",
		"test:funnel": "node --test marketing/funnel/scenario.test.mjs marketing/funnel/tracking.test.mjs marketing/typeform-intake/intake.test.mjs",
		"test:portal:ui": "node --test services/catalog_review_ui/*.test.mjs",
		"preview:dealflow": "python3 experiments/dealflow-preview/serve.py",
		"preview:chatgpt": "npm --prefix apps/chatgpt-space run dev",
